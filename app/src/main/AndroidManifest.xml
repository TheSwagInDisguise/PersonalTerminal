<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: lets the running focus timer be promoted to the status-bar chip / lock screen -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Heartbeat for the focus timer (Android 12: user-grantable; 13+: granted by default to timer-style apps). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Optional: Do-Not-Disturb while a focus phase runs (user grants it in system settings) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Health Connect auto-completion (steps / exercise / sleep / mindfulness) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />

    <!-- Lets the timer screen check whether the per-app "Live Updates" settings page exists (Android 16+) -->
    <queries>
        <intent>
            <action android:name="android.settings.APP_NOTIFICATION_PROMOTION_SETTINGS" />
        </intent>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".PersonalTerminalApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalTerminal"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PersonalTerminal">
            <!-- The LAUNCHER entry lives on the icon aliases below (settings › appearance › icon). -->
            <!-- Open .ptbak / .ptbakx archives and colour-scheme JSON files handed over by other apps -->
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-personal-terminal-backup" />
                <data android:pathPattern=".*\\.ptbak" />
                <data android:pathPattern=".*\\.ptbakx" />
            </intent-filter>
            <!-- Health Connect permission rationale (Android 13-) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
            <meta-data
                android:name="health_permissions_rationale"
                android:value="@string/health_permissions_rationale" />
        </activity>


        <!-- Selectable launcher icons: exactly one alias is enabled at a time (LauncherIcons.apply). -->
        <activity-alias
            android:name="dev.personalterminal.LauncherClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.personalterminal.LauncherPrompt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_prompt"
            android:roundIcon="@mipmap/ic_launcher_prompt"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.personalterminal.LauncherWatch"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_watch"
            android:roundIcon="@mipmap/ic_launcher_watch"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.personalterminal.LauncherCheckbox"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_checkbox"
            android:roundIcon="@mipmap/ic_launcher_checkbox"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.personalterminal.LauncherAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_amber"
            android:roundIcon="@mipmap/ic_launcher_amber"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.personalterminal.LauncherMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Health Connect permission rationale (Android 14+) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Home-screen widget (Glance) -->
        <receiver
            android:name=".widget.HabitWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.personalterminal.ACTION_WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/habit_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.StreakWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_streak_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/streak_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.TimerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_timer_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timer_widget_info" />
        </receiver>

        <!-- "done" button on reminder notifications -->
        <receiver
            android:name=".reminders.ReminderActionReceiver"
            android:exported="false" />

        <!-- Automation (Tasker / MacroDroid / adb): exported broadcast entry point, see docs/AUTOMATION.md -->
        <receiver
            android:name=".automation.AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="dev.personalterminal.action.COMPLETE" />
                <action android:name="dev.personalterminal.action.INCREMENT" />
                <action android:name="dev.personalterminal.action.SET" />
                <action android:name="dev.personalterminal.action.SKIP" />
                <action android:name="dev.personalterminal.action.WEAR" />
                <action android:name="dev.personalterminal.action.TIMER_START" />
                <action android:name="dev.personalterminal.action.TIMER_STOP" />
                <action android:name="dev.personalterminal.action.BACKUP" />
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile: start / stop the focus timer from the shade -->
        <service
            android:name=".timer.TimerTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_timer_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Quick Settings tile: tick the next due habit with one tap -->
        <service
            android:name=".tiles.DoneTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_done_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Vault home-screen widget: today's watch photo + next suggestion -->
        <receiver
            android:name=".widget.VaultWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_vault_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.personalterminal.ACTION_WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/vault_widget_info" />
        </receiver>

        <!-- Pomodoro timer foreground service -->
        <service
            android:name=".timer.PomodoroService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pomodoro focus timer that must keep counting while the app is in the background" />
        </service>

        <!-- Shares captured watch photos with the camera / other apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable the default WorkManager initializer; we initialise it manually in the Application class -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
